{
  "name": "encuentrame-bo",
  "version": "0.1.0",
  "private": true,
  "description": "encuentrame.bo — sistema nervioso digital para la economía informal de Bolivia",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @encuentrame/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules --root .\"",
    "emulators": "firebase emulators:start",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:hosting": "pnpm --filter @encuentrame/web build && firebase deploy --only hosting",
    "deploy:functions": "pnpm --filter @encuentrame/functions build && firebase deploy --only functions",
    "migrate": "tsx infra/migrations/run.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.1.0",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
