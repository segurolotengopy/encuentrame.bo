# Config pública del SDK de Firebase (NO son secretos: se protege con Security Rules + App Check)
# Consola Firebase → Configuración del proyecto → Tus apps → SDK de Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=encuentramebo-1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=encuentramebo-1
VITE_FIREBASE_STORAGE_BUCKET=encuentramebo-1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Clave de sitio reCAPTCHA Enterprise para App Check
VITE_APPCHECK_SITE_KEY=
# true para conectar a los emuladores locales
VITE_USE_EMULATORS=false
